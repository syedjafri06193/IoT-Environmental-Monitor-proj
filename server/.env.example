# Copy to .env and change every secret before exposing anything.
INFLUX_ORG=monitor
INFLUX_BUCKET=environment
INFLUX_TOKEN=change-me-influx-admin-token
INFLUX_PASSWORD=change-me-influx-password
GRAFANA_PASSWORD=change-me-grafana-password
CHIRPSTACK_API_SECRET=change-me-openssl-rand-base64-32

# Bridge / alerting
MQTT_TOPICS=application/+/device/+/event/up
SILENCE_FACTOR=3
# Expected uplink interval before the bridge has learned one (s). 4320 = SF12 on TTN.
EXPECTED_INTERVAL_S=4320
BATTERY_LOW_V=3.3
# Optional: POST alerts as JSON (e.g. an ntfy / Slack / Discord webhook)
ALERT_WEBHOOK_URL=
